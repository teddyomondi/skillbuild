# ============================================================================
# CodePulse AI IDE — Live LLM & Voice API Configuration (.env.example)
# Copy this file to .env or enter your API key directly in the IDE "Add LLM API" modal
# ============================================================================

# Provider: 'openai' | 'gemini' | 'anthropic' | 'custom'
VITE_LLM_PROVIDER=gemini

# Your LLM API Key
VITE_LLM_API_KEY=

# Optional model override (e.g., gpt-4o-mini, gemini-2.5-flash, claude-3-5-haiku-latest)
VITE_LLM_MODEL= 

# Optional custom OpenAI-compatible base URL (OpenRouter, Groq, Ollama, Together, etc.)
VITE_LLM_BASE_URL=

# Voice synthesis engine: 'browser-neural' | 'openai-tts'
VITE_TTS_ENGINE=browser-neural
VITE_TTS_VOICE=nova

VITE_SUPABASE_URL = 
VITE_SUPABASE_ANON_KEY = 
VITE_SUPABASE_SERVICE_ROLE_KEY = 